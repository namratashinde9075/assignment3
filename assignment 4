
#include <iostream>
using namespace std;

// Part A: Pointer and Reference

void swapByPointer(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

void swapByReference(int &a, int &b) {
    int temp = a;
    a = b;
    b = temp;
}

int main() {
    cout << "--- Part A: Pointer and Reference ---" << endl;

    int x = 10;
    int *ptr = &x;
    int &ref = x;

    cout << "x = " << x << endl;
    cout << "value using pointer = " << *ptr << endl;
    cout << "value using reference = " << ref << endl;

    *ptr = 20;
    cout << "x after changing with pointer = " << x << endl;

    ref = 30;
    cout << "x after changing with reference = " << x << endl;

    int a = 5, b = 9;

    cout << "\nBefore swap: a = " << a << ", b = " << b << endl;

    swapByPointer(&a, &b);
    cout << "After swapByPointer: a = " << a
         << ", b = " << b << endl;

    swapByReference(a, b);
    cout << "After swapByReference: a = " << a
         << ", b = " << b << endl;

    // Part B: New and Delete
    cout << "\n--- Part B: new and delete ---" << endl;

    int n = 3;
    int *arr = new int[n];

    cout << "Enter 3 numbers: ";
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << "Array elements: ";
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;

    delete[] arr;
    cout << "Dynamic memory released successfully." << endl;

    return 0;
}
