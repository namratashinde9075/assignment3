#include <iostream>
using namespace std;

// Assignment A: References and Pointers
void referencesAndPointers() {
    int a = 10;
    int &ref = a;
    int *ptr = &a;

    cout << "Assignment A: References and Pointers\n";
    cout << "Value of a: " << a << endl;
    cout << "Reference value: " << ref << endl;
    cout << "Address of a: " << ptr << endl;
    cout << "Value using pointer: " << *ptr << endl;
}

// Assignment B: New and Delete Operators
void dynamicMemory() {
    int *ptr = new int;

    cout << "\nAssignment B: New and Delete Operators\n";
    cout << "Enter a number: ";
    cin >> *ptr;

    cout << "Number: " << *ptr << endl;

    delete ptr;
    ptr = nullptr;
}

int main() {
    referencesAndPointers();
    dynamicMemory();

    return 0;
}
